# RouteLeak — environment configuration
# Copy to `.env` for local development. Never commit real values or secrets.

# Base URL of the authoritative RouteLeak backend (matching engine, CSV
# normalization, evidence lineage, exception state rules, auth, audit, D1/R2).
# When set, the app uses the HTTP ProductApi adapter and authenticates with the
# backend session cookie (HttpOnly) — no API keys belong in this file.
# When unset or empty, the app falls back to the clearly labeled demo adapter
# with fabricated sample data.
VITE_API_BASE_URL=
